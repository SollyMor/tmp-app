generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  nick          String
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  scheduleItems ScheduleItem[]
  dayMeetings   DayMeeting[]
  tasks         Task[]

  ownedWorkspaces    Workspace[]  @relation("WorkspaceOwner")
  memberships        Membership[]
  createdPlanTasks   PlanTask[]   @relation("PlanTaskCreator")
  assignedPlanTasks  PlanTask[]   @relation("PlanTaskAssignee")
}

model ScheduleItem {
  id        String   @id @default(cuid())
  time      String
  sortKey   Int
  title     String
  room      String
  color     String
  weekday   Int      @default(0)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday, sortKey])
}

/** Разовая встреча только на конкретную дату */
model DayMeeting {
  id        String   @id @default(cuid())
  date      String
  time      String
  sortKey   Int
  title     String
  room      String
  color     String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date, sortKey])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  time        String   @default("")
  startDate   String
  endDate     String
  priority    Int
  themeId     String
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  kind         String   @default("STUDY")
  ownerId      String
  joinCodeHash String
  createdAt    DateTime @default(now())

  owner    User         @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  Membership[]
  projects Project[]

  @@index([ownerId])
}

model Membership {
  workspaceId String
  userId      String
  role        String   @default("MEMBER")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planTasks PlanTask[]

  @@index([workspaceId])
}

/** Командная задача пространства (CRM / Планы) */
model PlanTask {
  id          String   @id @default(cuid())
  projectId   String
  creatorId   String
  assigneeId  String
  title       String
  description String   @default("")
  deadline    DateTime
  priority    String   @default("MEDIUM")
  estimateMin Int
  status      String   @default("TODO")
  progress    Int      @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User         @relation("PlanTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee  User         @relation("PlanTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  subtasks  PlanSubtask[]

  @@index([projectId, deadline])
  @@index([assigneeId, deadline])
}

model PlanSubtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  isDone    Boolean  @default(false)
  sortKey   Int      @default(0)
  createdAt DateTime @default(now())

  task PlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortKey])
}
